# AI Research Assistant - Manifest for package distribution

# Include documentation
include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include PROJECT_OVERVIEW.md

# Include configuration templates
include .env.example

# Include requirements
include requirements.txt

# Include test files
recursive-include tests *.py

# Exclude development files
exclude .gitignore
exclude .env

# Exclude build and cache directories
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store

# Exclude data directories (too large/sensitive)
prune data/
prune logs/
prune venv/

# Include empty directories for structure
graft workflows
graft interfaces
graft security  
graft monitoring